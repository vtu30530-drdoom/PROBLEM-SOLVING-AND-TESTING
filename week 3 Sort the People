import java.util.*;

class Solution {
    public String[] sortPeople(String[] names, int[] heights) {
        int n = names.length;
        Map<Integer, String> map = new HashMap<>();
        
        // Pair each height with its corresponding name
        for (int i = 0; i < n; i++) {
            map.put(heights[i], names[i]);
        }
        
        // Sort the heights array in ascending order
        Arrays.sort(heights);
        
        String[] result = new String[n];
        
        // Populate result array from highest height to lowest
        for (int i = 0; i < n; i++) {
            result[i] = map.get(heights[n - 1 - i]);
        }
        
        return result;
    }
}


input
names =
["Mary","John","Emma"]
heights =
[180,165,170]
Output
["Mary","Emma","John"]
Expected
["Mary","Emma","John"]
